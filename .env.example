# 复制为 .env 后填写：cp .env.example .env
# 这里只放占位符，仓库中不存在任何真实可用的密钥或口令。

# --- 会话 ---
# 必填。用于对会话标识做 HMAC 后入库；缺失时 api 直接启动失败，不会退回内置默认值。
# 生成方式示例：openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=8

# --- 数据库 ---
# DB_ROOT_PASSWORD 只给 db 容器初始化使用，不下发给 api。
DB_ROOT_PASSWORD=
DB_NAME=campusclaw
DB_USER=campusclaw_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=3306

# --- 上传 ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=2097152

# --- 登录失败限流（按用户名 + 客户端 IP）---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# --- 预置账号口令（至少 8 位；以 bcrypt 哈希入库）---
SEED_TEACHER_A_PASSWORD=
SEED_STUDENT_A1_PASSWORD=
SEED_STUDENT_B1_PASSWORD=
