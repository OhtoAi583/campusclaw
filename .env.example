# 复制为 .env 后填写：cp .env.example .env
# 这里只放占位符，仓库中不存在任何真实可用的密钥或口令。

# --- token 方案（JWT）---
# 访问令牌签名密钥；必填，缺失时启动失败。生成：openssl rand -hex 32
JWT_SECRET=
# 访问令牌有效期（分钟）与刷新令牌有效期（天）
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- 服务 ---
# api 监听端口（容器内固定 8080；对外端口由 docker-compose 的 web 映射决定）
APP_PORT=8080

# --- 会话 ---
# 必填。用于对会话标识做 HMAC 后入库；缺失时 api 直接启动失败，不会退回内置默认值。
# 生成方式示例：openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=8

# --- 数据库 ---
# DB_ROOT_PASSWORD 只给 db 容器初始化使用，不下发给 api。
DB_ROOT_PASSWORD=
DB_NAME=campusclaw
DB_USER=campusclaw_user
DB_PASSWORD=
DB_HOST=db
DB_PORT=3306

# --- 上传 ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=2097152

# --- 登录失败限流（按用户名 + 客户端 IP）---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# --- 知识库检索 ---
# 向量维度：改这个值必须先重建索引（bin/reindex），否则服务会拒绝启动。
EMBEDDING_DIM=512
# 分块目标长度（字符）与相邻块重叠（必须小于 CHUNK_SIZE）
CHUNK_SIZE=600
CHUNK_OVERLAP=80
# 单次检索最多返回多少条，以及查询长度上限
SEARCH_TOP_K_MAX=20
SEARCH_QUERY_MAX_CHARS=200
# 单次检索超时（毫秒），超时返回 503，不返回部分结果
SEARCH_TIMEOUT_MS=1500
# 最低相似度阈值：低于它的候选算作"没有匹配"
SEARCH_MIN_SCORE=0.15

# --- 预置账号口令（至少 8 位；以 bcrypt 哈希入库）---
SEED_TEACHER_A_PASSWORD=
SEED_STUDENT_A1_PASSWORD=
SEED_STUDENT_B1_PASSWORD=
